{
  "name": "chest-form",
  "version": "0.2.0",
  "author": "SerenityJS",
  "description": "Sample plugin provides a basic configuration for plugin usage in the SerenityJS software.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs"
    ],
    "dts": true,
    "clean": true,
    "minify": true
  },
  "keywords": [
    "Sample",
    "Example"
  ],
  "peerDependencies": {
    "@serenityjs/core": "^0.8.16-beta-20251130234219",
    "@serenityjs/plugins": "^0.8.16-beta-20251130234219",
    "@serenityjs/protocol": "^0.8.16-beta-20251130234219"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist/**",
    "README.md"
  ]
}
